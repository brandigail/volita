# Placeholder names only. Copy to .env.local (and Netlify env vars) and fill in real values. Never commit real keys.
GROQ_API_KEY=your-groq-api-key
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=generate-a-long-random-string
# Local dev URL. On Netlify leave unset; the site URL is used automatically.
BETTER_AUTH_URL=http://localhost:8888
# Optional: override the Groq model used by generate.ts (default qwen/qwen3.8-27b)
GROQ_MODEL=
# Optional: total drafts or recordings all users together may make per 24 hours (default 600 each)
GLOBAL_DAILY_LIMIT=

# Optional tuning for the voice assistant
# GROQ_ASSISTANT_MODEL=openai/gpt-oss-20b
# GROQ_TTS_VOICE=hannah
# (assistant turns a day now come from the plan: see src/types/plans.ts)

# Who sees the subscriptions preview: "all", "off", or a comma separated list of account emails
# FEATURE_SUBSCRIPTIONS=you@example.com

# PayFast subscriptions. Without these the public sandbox test merchant is used and no real money moves.
# PAYFAST_MODE=sandbox            (set to "live" only when real payments are approved)
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# Confirmation emails after a payment (Resend, free tier)
# RESEND_API_KEY=
# MAIL_FROM=Volita <onboarding@resend.dev>

# 32 random bytes, base64. Losing this key makes encrypted data unreadable, so keep a copy in a password manager.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DATA_ENCRYPTION_KEY=

# Sign-up is closed by default. Set to true only while a new person needs an account, then remove it.
# ALLOW_SIGNUP=true

# Accounts whose activity (what they say, drafts, errors) is recorded for the owner, comma separated. They are told in the app.
# Read it with: node --env-file=.env.local scripts/activity-report.ts <email>
# ACTIVITY_LOG_EMAILS=tester@example.com
# Optional: logging switches itself off after this day (YYYY-MM-DD)
# ACTIVITY_LOG_UNTIL=2026-11-30

# Accounts that always have Pro and can see the family screen (who gets Pro for free). Comma separated.
# OWNER_EMAILS=you@example.com

# Gmail (the assistant can search, read and prepare replies; the person approves every send).
# Google Cloud console: create a project, enable the Gmail API, set up the OAuth consent screen (External, Testing) and
# add each person's Gmail as a test user, then create an OAuth client of type "Web application" with the redirect
# addresses http://localhost:8888/api/gmail/callback and https://YOUR-SITE.netlify.app/api/gmail/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Only needed when the site address differs from the redirect address registered with Google:
# GOOGLE_REDIRECT_URI=

# Outlook and Hotmail (Microsoft no longer allows app passwords, so they need this sign-in). Without these the Outlook
# button says "Soon"; Yahoo, AOL, iCloud, Zoho and business email work without any setting (app passwords).
# entra.microsoft.com > App registrations > New registration: "Accounts in any organizational directory and personal
# Microsoft accounts", Web redirect addresses http://localhost:8888/api/mail/outlook/callback and
# https://YOUR-SITE.netlify.app/api/mail/outlook/callback. API permissions (delegated): Mail.Read, Mail.Send,
# offline_access, openid, email. Certificates & secrets > New client secret.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=

# Safety alerts (card numbers, bank details or passwords tried 3 times, limits hammered, too many emails) are emailed
# to every OWNER_EMAILS address through Resend (RESEND_API_KEY above). They are also listed on the Family screen.
